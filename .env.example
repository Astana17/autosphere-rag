# Copy to `.env` and adjust. Never commit `.env`.

# --- Paths ---
INDEX_DIR=data/index
CHUNKS_PATH=data/chunks.jsonl
PROCESSED_DIR=data/processed
EMBEDDING_CACHE_DIR=data/index/embedding_cache

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# --- LLM (default: local Ollama) ---
LLM_PROVIDER=ollama
LLM_MODEL_NAME=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# OpenAI-compatible alternative:
# LLM_PROVIDER=openai
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# --- Retrieval cache ---
RETRIEVAL_CACHE_MAX_ENTRIES=2048

# --- Chunking (used by scripts) ---
ARTICLE_MAX_CHARS=1500
CHUNK_OVERLAP=100
